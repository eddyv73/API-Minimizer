# Archivos y directorios a ignorar durante el build de Docker

# Archivos de sistema
.DS_Store
Thumbs.db

# Archivos de desarrollo
*.user
*.suo
*.userosscache
*.sln.docstates
*.userprefs

# Directorios de build
bin/
obj/
out/
build/
dist/

# Archivos de configuración de IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Archivos de logs
*.log
logs/

# Archivos temporales
tmp/
temp/
*.tmp

# Archivos de Docker
Dockerfile*
docker-compose*
.dockerignore

# Archivos de Git
.git/
.gitignore

# Archivos de documentación
README.md
*.md
docs/

# Archivos de configuración local
appsettings.Development.json
appsettings.Local.json

# Archivos de test
**/test/
**/tests/
**/Testing/
*.test.cs
*.spec.cs

# Archivos de coverage
coverage/
*.coverage
*.coveragexml

# Archivos de NuGet
packages/
*.nupkg

# Archivos de Node.js (si se usan)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Archivos de Python (si se usan)
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/

# Archivos de Java (si se usan)
*.class
*.jar
*.war
*.ear
target/